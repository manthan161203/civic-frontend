            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"District Admin Name\",\n  \"phone\": \"+919876543210\",\n  \"role\": \"district_admin\",\n  \"district_id\": \"district_123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/sub-admins",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "sub-admins"]
            },
            "description": "Create a new sub-admin account"
          }
        },
        {
          "name": "List Sub-Admins",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/sub-admins",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "sub-admins"]
            },
            "description": "Get list of sub-admin accounts"
          }
        },
        {
          "name": "Update Sub-Admin",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Admin Name\",\n  \"role\": \"district_admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/sub-admins/{{adminId}}",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "sub-admins", "{{adminId}}"]
            },
            "description": "Update sub-admin details"
          }
        },
        {
          "name": "Delete Sub-Admin",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/sub-admins/{{adminId}}",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "sub-admins", "{{adminId}}"]
            },
            "description": "Delete a sub-admin account"
          }
        }
      ]
    },
