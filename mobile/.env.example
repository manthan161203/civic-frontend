# Civic Mobile App Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT COMMIT .env TO VERSION CONTROL!
# See SECURITY.md for setup instructions

# ── Build environment ────────────────────────────────────────────────────────
# Selects the target in app.config.js: development | staging | production.
# Controls the app name, bundle identifier, API URL and whether cleartext HTTP
# is permitted. Set it on the build command, not here:
#   APP_ENV=staging eas build --profile staging
APP_ENV=development

# Overrides the per-environment API URL from app.config.js.
# In development, set this to your machine's LAN address when testing on a
# physical device — "localhost" there means the phone itself.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Google Maps API Key
# Get this from: https://cloud.google.com/maps-platform
# Make sure to enable Maps SDK for Android/iOS
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google OAuth Client IDs  
# Get these from: https://console.cloud.google.com/apis/credentials
# Web Client ID (for login flow)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com

# iOS Client ID
EXPO_PUBLIC_GOOGLE_iOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com

# Android Client ID
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_android_client_id.apps.googleusercontent.com
